<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stage (d): the embedded server binds 127.0.0.1 by default; INTERNET is
         needed for the opt-in LAN mode and for the HuggingFace portal (stage h). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Stage (d): foreground service that owns the local OpenAI-compatible server.
         FOREGROUND_SERVICE_DATA_SYNC is required from API 34 (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+: runtime permission gating the service's status notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HermesLlama">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stage (d): local inference server, started on demand by the AI itself. -->
        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>