<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stage (d): the embedded server binds 127.0.0.1 by default; INTERNET is
         needed for the opt-in LAN mode and for the HuggingFace portal (stage h). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Stage (d): foreground service that owns the local OpenAI-compatible server.
         FOREGROUND_SERVICE_DATA_SYNC is required from API 34 (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+: runtime permission gating the service's status notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- API 28 only: needed to save generated artifacts to public Downloads. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- mDNS for the live server (multicast sockets need these normal perms). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HermesLlama">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stage (d): local inference server, started on demand by the AI itself. -->
        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 14th requirement: share/open/test generated artifacts. Grants other
             apps read access to our generated/* files via content URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>